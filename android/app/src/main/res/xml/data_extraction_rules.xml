<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的云备份 / 设备迁移规则：排除缓存目录 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cache/" />
    </device-transfer>
</data-extraction-rules>
